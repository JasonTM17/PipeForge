# Local development defaults only. Never reuse these values outside development.
PIPEFORGE_ENV=development
PIPEFORGE_LOG_LEVEL=info
PIPEFORGE_HTTP_ADDR=:8080
PIPEFORGE_API_PORT=58080
PIPEFORGE_DATABASE_MAX_CONNS=10
PIPEFORGE_SHUTDOWN_TIMEOUT=10s

POSTGRES_HOST=localhost
# Host ports use a PipeForge-specific range to avoid colliding with other local stacks.
POSTGRES_PORT=55433
POSTGRES_DATABASE=pipeforge
POSTGRES_USER=pipeforge
POSTGRES_PASSWORD=pipeforge-local-postgres

RABBITMQ_HOST=localhost
RABBITMQ_PORT=55672
RABBITMQ_MANAGEMENT_PORT=55673
RABBITMQ_USER=pipeforge
RABBITMQ_PASSWORD=pipeforge-local-rabbitmq

MINIO_PORT=59010
MINIO_CONSOLE_PORT=59011
MINIO_ENDPOINT=localhost:59010
MINIO_ACCESS_KEY=pipeforge
MINIO_SECRET_KEY=pipeforge-local-minio-secret
MINIO_SECURE=false

JWT_SIGNING_KEY=pipeforge-local-jwt-key-change-me
PIPEFORGE_ACCESS_TOKEN_TTL=15m
PIPEFORGE_REFRESH_TOKEN_TTL=720h

PROMETHEUS_PORT=59090
GRAFANA_PORT=53010
