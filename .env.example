# Local development defaults only. Never reuse these values outside development.
PIPEFORGE_ENV=development
PIPEFORGE_LOG_LEVEL=info
PIPEFORGE_HTTP_ADDR=:8080
PIPEFORGE_API_PORT=58080
PIPEFORGE_DATABASE_MAX_CONNS=10
PIPEFORGE_SHUTDOWN_TIMEOUT=10s
PIPEFORGE_LEASE_DURATION=2m
PIPEFORGE_LEASE_RENEWAL_WINDOW=2m
PIPEFORGE_LEASE_SWEEP_LIMIT=100

POSTGRES_HOST=localhost
# Host ports use a PipeForge-specific range to avoid colliding with other local stacks.
POSTGRES_PORT=55433
POSTGRES_DATABASE=pipeforge
POSTGRES_USER=pipeforge
POSTGRES_PASSWORD=pipeforge-local-postgres

RABBITMQ_HOST=localhost
RABBITMQ_PORT=55672
RABBITMQ_MANAGEMENT_PORT=55673
RABBITMQ_USER=pipeforge
RABBITMQ_PASSWORD=pipeforge-local-rabbitmq
RABBITMQ_URL=amqp://pipeforge:pipeforge-local-rabbitmq@localhost:55672/

MINIO_PORT=59010
MINIO_CONSOLE_PORT=59011
MINIO_ENDPOINT=localhost:59010
MINIO_PUBLIC_ENDPOINT=localhost:59010
MINIO_ACCESS_KEY=pipeforge
MINIO_SECRET_KEY=pipeforge-local-minio-secret
MINIO_SECURE=false
MINIO_PUBLIC_SECURE=false
MINIO_DATASET_BUCKET=datasets

JWT_SIGNING_KEY=pipeforge-local-jwt-key-change-me
PIPEFORGE_ACCESS_TOKEN_TTL=15m
PIPEFORGE_REFRESH_TOKEN_TTL=720h
PIPEFORGE_MAX_UPLOAD_BYTES=67108864
PIPEFORGE_MULTIPART_PART_SIZE=8388608
PIPEFORGE_MULTIPART_MAX_PARTS=10000
PIPEFORGE_MULTIPART_MAX_BYTES=5368709120
PIPEFORGE_MULTIPART_SESSION_TTL=24h
PIPEFORGE_MULTIPART_URL_TTL=15m
PIPEFORGE_MULTIPART_COMPLETION_GRACE=1h
PIPEFORGE_MULTIPART_CLEANUP_LIMIT=100

PROMETHEUS_PORT=59090
GRAFANA_PORT=53010

PIPEFORGE_WORKER_PORT=58090
PIPEFORGE_WORKER_HEALTH_ONLY=true
PIPEFORGE_WORKER_MAX_CONCURRENCY=2
PIPEFORGE_WORKER_PREFETCH=2
PIPEFORGE_WORKER_HEARTBEAT_INTERVAL=15
PIPEFORGE_WORKER_QUEUE=processing.jobs
