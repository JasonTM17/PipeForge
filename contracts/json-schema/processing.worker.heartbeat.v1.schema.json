{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pipeforge.dev/contracts/processing.worker.heartbeat.v1.schema.json",
  "title": "Processing worker heartbeat v1",
  "allOf": [
    { "$ref": "envelope.v1.schema.json" },
    {
      "properties": {
        "messageType": { "const": "processing.worker.heartbeat" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["workerId", "instanceId", "hostname", "supportedOperations", "softwareVersion", "status", "currentConcurrency", "maxConcurrency", "currentJobIds", "observedAt"],
          "properties": {
            "workerId": { "type": "string", "format": "uuid" },
            "instanceId": { "type": "string", "minLength": 1, "maxLength": 128 },
            "hostname": { "type": "string", "minLength": 1, "maxLength": 255 },
            "supportedOperations": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "type": "string", "minLength": 1, "maxLength": 64 } },
            "softwareVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
            "status": { "enum": ["STARTING", "READY", "BUSY", "DRAINING", "UNHEALTHY", "OFFLINE"] },
            "currentConcurrency": { "type": "integer", "minimum": 0 },
            "maxConcurrency": { "type": "integer", "minimum": 1 },
            "currentJobIds": { "type": "array", "maxItems": 128, "items": { "type": "string", "format": "uuid" } },
            "observedAt": { "type": "string", "format": "date-time" }
          }
        }
      }
    }
  ]
}
