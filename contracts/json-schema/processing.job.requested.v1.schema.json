{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pipeforge.dev/contracts/processing.job.requested.v1.schema.json",
  "title": "Processing job requested v1",
  "allOf": [
    { "$ref": "envelope.v1.schema.json" },
    {
      "properties": {
        "messageType": { "const": "processing.job.requested" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["jobId", "datasetVersionId", "operations"],
          "properties": {
            "jobId": { "type": "string", "format": "uuid" },
            "datasetVersionId": { "type": "string", "format": "uuid" },
            "attemptId": { "type": ["string", "null"], "format": "uuid" },
            "leaseId": { "type": ["string", "null"], "format": "uuid" },
            "workerId": { "type": ["string", "null"], "format": "uuid" },
            "attemptNumber": { "type": "integer", "minimum": 1 },
            "operations": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["type", "config"],
                    "properties": {
                      "type": { "const": "PROFILE_DATASET" },
                      "config": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "sampling": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                              "strategy": { "const": "RESERVOIR" },
                              "maxRows": { "type": "integer", "minimum": 0, "maximum": 100000 },
                              "seed": { "type": "integer", "minimum": 0, "maximum": 2147483647 }
                            }
                          },
                          "includeCommonValues": { "type": "boolean" },
                          "maxCommonValues": { "type": "integer", "minimum": 0, "maximum": 100 },
                          "quantiles": {
                            "type": "array",
                            "minItems": 1,
                            "maxItems": 32,
                            "uniqueItems": true,
                            "items": { "type": "number", "minimum": 0, "maximum": 1 }
                          },
                          "distinctStrategy": { "enum": ["EXACT", "APPROXIMATE"] },
                          "maxDistinctValues": { "type": "integer", "minimum": 128, "maximum": 1000000 },
                          "maxMemoryBytes": { "type": "integer", "minimum": 1048576, "maximum": 4294967296 },
                          "sensitiveColumns": {
                            "type": "array",
                            "maxItems": 256,
                            "uniqueItems": true,
                            "items": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$" }
                          }
                        }
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["type", "config"],
                    "properties": {
                      "type": { "const": "CHECK_MISSING_VALUES" },
                      "config": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["columns"],
                        "properties": {
                          "columns": {
                            "type": "array",
                            "minItems": 1,
                            "maxItems": 256,
                            "items": {
                              "type": "string",
                              "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["type", "config"],
                    "properties": {
                      "type": { "const": "CHECK_DUPLICATES" },
                      "config": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["keyColumns"],
                        "properties": {
                          "keyColumns": {
                            "type": "array",
                            "minItems": 1,
                            "maxItems": 256,
                            "items": {
                              "type": "string",
                              "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["type", "config"],
                    "properties": {
                      "type": { "const": "DETECT_OUTLIERS" },
                      "config": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["column", "method"],
                        "properties": {
                          "column": {
                            "type": "string",
                            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"
                          },
                          "method": { "enum": ["IQR", "Z_SCORE", "MODIFIED_Z_SCORE"] },
                          "threshold": { "type": "number", "minimum": 0.0001, "maximum": 1000 },
                          "nullPolicy": { "enum": ["SKIP", "FAIL"] },
                          "minimumSampleSize": { "type": "integer", "minimum": 3, "maximum": 1000000 },
                          "sampleOutputLimit": { "type": "integer", "minimum": 0, "maximum": 128 }
                        }
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["type", "config"],
                    "properties": {
                      "type": { "const": "VALIDATE_QUALITY" },
                      "config": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["rules"],
                        "properties": {
                          "rules": {
                            "type": "array",
                            "minItems": 1,
                            "maxItems": 256,
                            "items": { "$ref": "#/$defs/qualityRule" }
                          }
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "qualityRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "columnScope", "ruleType", "configuration", "severity", "enabled"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "columnScope": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$" }
        },
        "ruleType": {
          "enum": ["NOT_NULL", "UNIQUE", "BETWEEN", "MIN_LENGTH", "MAX_LENGTH", "REGEX", "EMAIL_FORMAT", "DATE_FORMAT", "ALLOWED_VALUES", "COLUMN_TYPE", "ROW_COUNT_BETWEEN", "REFERENTIAL_SET"]
        },
        "configuration": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "min": { "type": "number" },
            "max": { "type": "number" },
            "value": { "type": "integer", "minimum": 0, "maximum": 1000000 },
            "pattern": { "type": "string", "minLength": 1, "maxLength": 512 },
            "format": { "type": "string", "minLength": 1, "maxLength": 64 },
            "values": { "type": "array", "minItems": 1, "maxItems": 10000 },
            "type": { "enum": ["string", "integer", "number", "boolean", "date", "datetime"] },
            "maxTrackedValues": { "type": "integer", "minimum": 1, "maximum": 2000000 }
          }
        },
        "severity": { "enum": ["INFO", "WARNING", "ERROR", "CRITICAL"] },
        "enabled": { "type": "boolean" }
      }
    }
  }
}
