{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pipeforge.dev/contracts/processing.job.requested.v1.schema.json",
  "title": "Processing job requested v1",
  "allOf": [
    { "$ref": "envelope.v1.schema.json" },
    {
      "properties": {
        "messageType": { "const": "processing.job.requested" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["jobId", "datasetVersionId", "operations"],
          "properties": {
            "jobId": { "type": "string", "format": "uuid" },
            "datasetVersionId": { "type": "string", "format": "uuid" },
            "operations": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["type", "config"],
                    "properties": {
                      "type": { "const": "PROFILE_DATASET" },
                      "config": {
                        "type": "object",
                        "additionalProperties": false,
                        "maxProperties": 0
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["type", "config"],
                    "properties": {
                      "type": { "const": "CHECK_MISSING_VALUES" },
                      "config": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["columns"],
                        "properties": {
                          "columns": {
                            "type": "array",
                            "minItems": 1,
                            "maxItems": 256,
                            "items": {
                              "type": "string",
                              "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["type", "config"],
                    "properties": {
                      "type": { "const": "CHECK_DUPLICATES" },
                      "config": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["keyColumns"],
                        "properties": {
                          "keyColumns": {
                            "type": "array",
                            "minItems": 1,
                            "maxItems": 256,
                            "items": {
                              "type": "string",
                              "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["type", "config"],
                    "properties": {
                      "type": { "const": "DETECT_OUTLIERS" },
                      "config": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["column", "method"],
                        "properties": {
                          "column": {
                            "type": "string",
                            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"
                          },
                          "method": { "enum": ["IQR", "Z_SCORE"] }
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
