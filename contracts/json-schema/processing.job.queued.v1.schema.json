{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pipeforge.dev/contracts/processing.job.queued.v1.schema.json",
  "title": "Processing job queued v1",
  "allOf": [
    { "$ref": "envelope.v1.schema.json" },
    {
      "properties": {
        "messageType": { "const": "processing.job.queued" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["jobId"],
          "properties": {
            "jobId": { "type": "string", "format": "uuid" }
          }
        }
      }
    }
  ]
}
