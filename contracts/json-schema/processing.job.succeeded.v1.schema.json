{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pipeforge.dev/contracts/processing.job.succeeded.v1.schema.json",
  "title": "Processing job succeeded v1",
  "allOf": [
    { "$ref": "envelope.v1.schema.json" },
    {
      "properties": {
        "messageType": { "const": "processing.job.succeeded" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["jobId", "attemptId", "leaseId", "workerId", "artifacts"],
          "properties": {
            "jobId": { "type": "string", "format": "uuid" },
            "attemptId": { "type": "string", "format": "uuid" },
            "leaseId": { "type": "string", "format": "uuid" },
            "workerId": { "type": "string", "format": "uuid" },
            "artifacts": {
              "type": "array",
              "maxItems": 32,
              "items": { "type": "string", "minLength": 1, "maxLength": 512 }
            }
          }
        }
      }
    }
  ]
}
