{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pipeforge.dev/contracts/processing.job.started.v1.schema.json",
  "title": "Processing job started v1",
  "allOf": [
    { "$ref": "envelope.v1.schema.json" },
    {
      "properties": {
        "messageType": { "const": "processing.job.started" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["jobId", "attemptId", "leaseId", "workerId", "attemptNumber"],
          "properties": {
            "jobId": { "type": "string", "format": "uuid" },
            "attemptId": { "type": "string", "format": "uuid" },
            "leaseId": { "type": "string", "format": "uuid" },
            "workerId": { "type": "string", "format": "uuid" },
            "attemptNumber": { "type": "integer", "minimum": 1 }
          }
        }
      }
    }
  ]
}
