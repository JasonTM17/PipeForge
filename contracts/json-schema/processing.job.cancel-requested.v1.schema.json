{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pipeforge.dev/contracts/processing.job.cancel-requested.v1.schema.json",
  "title": "Processing job cancellation requested v1",
  "allOf": [
    { "$ref": "envelope.v1.schema.json" },
    {
      "properties": {
        "messageType": { "const": "processing.job.cancel-requested" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["jobId", "reason"],
          "properties": {
            "jobId": { "type": "string", "format": "uuid" },
            "attemptId": { "type": ["string", "null"], "format": "uuid" },
            "reason": { "type": "string", "minLength": 1, "maxLength": 500 }
          }
        }
      }
    }
  ]
}
