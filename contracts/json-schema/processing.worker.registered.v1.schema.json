{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pipeforge.dev/contracts/processing.worker.registered.v1.schema.json",
  "title": "Processing worker registered v1",
  "allOf": [
    { "$ref": "envelope.v1.schema.json" },
    {
      "properties": {
        "messageType": { "const": "processing.worker.registered" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["workerId", "instanceId", "hostname", "supportedOperations", "softwareVersion", "maxConcurrency", "startedAt"],
          "properties": {
            "workerId": { "type": "string", "format": "uuid" },
            "instanceId": { "type": "string", "minLength": 1, "maxLength": 128 },
            "hostname": { "type": "string", "minLength": 1, "maxLength": 255 },
            "supportedOperations": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "type": "string", "minLength": 1, "maxLength": 64 } },
            "softwareVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
            "maxConcurrency": { "type": "integer", "minimum": 1 },
            "startedAt": { "type": "string", "format": "date-time" }
          }
        }
      }
    }
  ]
}
